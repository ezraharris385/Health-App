{
  "name": "health-app",
  "version": "1.0.0",
  "private": true,
  "description": "Personal health tracking app: workout, nutrition, sleep, vitamins \u2014 each with an AI agent, coordinated by a master agent.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "build:pages": "cross-env VITE_LOCAL_MODE=1 PAGES_BASE=/Health-App/ vite build",
    "build:local": "cross-env VITE_LOCAL_MODE=1 vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "sql.js": "^1.12.0",
    "@types/sql.js": "^1.4.9"
  }
}